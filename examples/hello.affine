--
-- LucidScript face. Distinctive features exercised: module declaration
-- with `where`, type signatures as `name :: Type`, equation-style
-- function definitions, `--` line comments.
-- face: lucidscript

module Hello where

effect IO {
  fn println(s: String) -> ();
}

main :: -{IO}-> ()
main () = println("Hello, LucidScript!")
