# lucid — LucidScript shim. Forwards arguments to the affinescript CLI
# with --face lucid injected right after the subcommand. Source files
# should still use the canonical .affine extension and a face: lucidscript
# pragma; this shim only saves typing the --face flag for routine use.

if [ $# -eq 0 ]; then
  exec affinescript
fi
subcmd="$1"
shift
exec affinescript "$subcmd" --face lucid "$@"
